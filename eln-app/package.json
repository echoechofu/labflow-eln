  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "tsx server.ts & vite",
    "vite:dev": "vite --host 127.0.0.1",
    "db": "tsx server.ts",
    "build": "npm run build:web",
    "build:web": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint --ignore-pattern 'src-tauri/target/**'",
    "test": "node --import tsx --test tests/*.test.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app",
    "mcp:build": "cargo +1.98.0 build --release --manifest-path src-tauri/Cargo.toml --bin labflow-mcp",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^9.6.0",
