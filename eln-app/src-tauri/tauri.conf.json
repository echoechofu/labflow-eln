{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabFlow",
  "version": "0.1.7",
  "identifier": "io.labflow.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LabFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/labflow-mcp"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENjI0QUY1MzM3NUY0QkEKUldTNjlIVXo5VXBpSFRVa3NIZHM4SDhDWWMrVmdFaENsSTVOeFhUc2FJakRvZ3BhSW9NQ3JvT2kK",
      "endpoints": [
        "https://github.com/echoechofu/labflow-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
