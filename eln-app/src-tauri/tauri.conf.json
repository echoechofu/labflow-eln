{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabFlow",
  "version": "0.1.1",
  "identifier": "io.labflow.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LabFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
